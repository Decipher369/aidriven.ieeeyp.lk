# Next.js client URL; never place a service-role key in public configuration.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable/anon key only.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public CAPTCHA site key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Production origin for Edge Function CORS and auth redirects.
SITE_URL=
# Email display name.
EVENT_NAME=AIDSL 2026 Summit
# ISO timestamp with timezone; leave empty until the date is confirmed.
EVENT_DATE=
# Venue display label until confirmed.
VENUE=To be announced
# Organizer display name.
ORG_NAME=AI Driven Sri Lanka and IEEE Young Professionals Sri Lanka
# ISO currency code; awaiting organizer confirmation.
CURRENCY=
# Verified Brevo sender; configure as an Edge Function secret.
SENDER_EMAIL=
# Brevo REST API key; Edge Function secret only.
BREVO_API_KEY=
# Random webhook authentication secret; Edge Function secret only.
EMAIL_WEBHOOK_SECRET=
# CAPTCHA verification secret; Edge Function secret only.
TURNSTILE_SECRET=
# Real email backing the manually provisioned admin account; awaiting input.
ADMIN_ACCOUNT_EMAIL=
# Public real email backing the admin login alias (not a password or role).
NEXT_PUBLIC_ADMIN_ACCOUNT_EMAIL=
# Public currency code for display; must match the confirmed event currency.
NEXT_PUBLIC_CURRENCY=
# Matching expiry logic will be implemented in Phase 2.
HOLD_EXPIRY_DAYS=3
# Reminder scheduling waits for a confirmed event date.
REMINDER_DAYS_BEFORE=2
# Matches the Phase 1 constraint; changing it needs a new migration.
MAX_MERCH_QTY_PER_LINE=5
# No service-role key or admin password belongs in this file.
# Supabase supplies the service-role key to Edge Functions automatically.
# Enter Brevo SMTP credentials in Supabase Auth settings, not frontend env.
